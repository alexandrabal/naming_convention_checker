def _norm(col):
    return re.sub(r"[^a-z0-9]", "", str(col).lower())


def _find_col(df, wanted, required=True):
    """
    Find a column by header (or the first of a list of headers), ignoring case,
    spaces, * and punctuation. Returns None if not found and not required.
    """
    lookup = {_norm(c): c for c in df.columns}
    for w in (wanted if isinstance(wanted, (list, tuple)) else [wanted]):
        key = _norm(w)
        if key in lookup:
            return lookup[key]
        # Long headers sometimes get cut short: accept a column the header starts with.
        starts = [c for k, c in lookup.items() if len(k) >= 12 and key.startswith(k)]
        if len(starts) == 1:
            return starts[0]
    if not required:
        return None
    raise KeyError(f"None of {wanted} found. Your columns are: {list(df.columns)} "
                   f"- put the right header in NAME_COL at the top.")


