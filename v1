def _value_ok(field, value):
    if "allowed" in field:
        return value in field["_allowed_set"]
    return re.match(field["pattern"], value) is not None


for _f in CONVENTION:
    if "allowed" in _f:
        _f["_allowed_set"] = set(_f["allowed"])


def _bad_value_msg(field, value):
    if "allowed" in field:
        opts = field["allowed"]
        hint = ", ".join(opts) if len(opts) <= 12 else "see data dictionary"
        return f"{field['label']}: '{value}' isn't an allowed code ({hint})"
    return f"{field['label']}: '{value}' isn't a valid initiative id (e.g. 27-tst-t01-src, 27-bau)"


def _align(segments):
    """
    Match segments to fields allowing optional fields to be left out.
    Edit-distance style: picks the reading of the name with the fewest problems,
    so a missing field is reported as missing rather than shifting every later
    field into the wrong slot.
    """
    n, m = len(CONVENTION), len(segments)
    INF = float("inf")
    cost = [[INF] * (m + 1) for _ in range(n + 1)]
    back = [[None] * (m + 1) for _ in range(n + 1)]
    cost[0][0] = 0
    for i in range(n + 1):
        for j in range(m + 1):
            c = cost[i][j]
            if c == INF:
                continue
            if i < n and j < m:                          # field i uses segment j
                f, v = CONVENTION[i], segments[j]
                step = 0 if (v == "" and not f["required"]) or (v and _value_ok(f, v)) else 1
                if c + step < cost[i + 1][j + 1]:
                    cost[i + 1][j + 1], back[i + 1][j + 1] = c + step, ("use", i, j)
            if i < n:                                    # field i left out
                step = 1 if CONVENTION[i]["required"] else 0
                if c + step < cost[i + 1][j]:
                    cost[i + 1][j], back[i + 1][j] = c + step, ("skip", i, None)
            if j < m:                                    # segment j doesn't belong
                if c + 1 < cost[i][j + 1]:
                    cost[i][j + 1], back[i][j + 1] = c + 1, ("extra", None, j)

    steps, i, j = [], n, m
    while (i, j) != (0, 0):
        kind, fi, sj = back[i][j]
        steps.append((kind, fi, sj))
        if kind == "use":
            i, j = i - 1, j - 1
        elif kind == "skip":
            i -= 1
        else:
            j -= 1
    return list(reversed(steps))


def validate_name(name, source_platform=None, known_initiatives=KNOWN_INITIATIVES):
    """
    Returns dict: is_compliant (bool), issues (list[str]), parsed ({field: value}).
    """
    if name is None or (isinstance(name, float) and name != name):  # None / NaN
        name = ""
    raw = str(name)
    name = raw.strip()
    issues, parsed = [], {}

    if not name:
        return {"is_compliant": False, "issues": ["Campaign name is empty"], "parsed": {}}

    if raw != name:
        issues.append("Has leading/trailing spaces")
    if name != name.lower():
        issues.append("Must be all lowercase")
    if " " in name:
        issues.append("Contains spaces (use - inside a value, _ between fields)")
    if len(name) > MAX_LENGTH:
        issues.append(f"Too long ({len(name)} characters, max {MAX_LENGTH})")
    bad_chars = sorted(set(re.sub(r"[a-z0-9_\-]", "", name.lower().replace(" ", ""))))
    if bad_chars:
        issues.append(f"Contains characters not allowed: {' '.join(bad_chars)}")

    segments = name.lower().split(DELIMITER)

    # Free text or a completely different structure: one clear message.
    if len(segments) < 4:
        issues.append("Doesn't follow the FY27 structure "
                      "(brand_program_outcome_27-type-id_goal_channel_platform_...)")
        return {"is_compliant": False, "issues": issues, "parsed": {}}

    for kind, fi, sj in _align(segments):
        if kind == "use":
            f, v = CONVENTION[fi], segments[sj]
            if v == "":
                if f["required"]:
                    issues.append(f"Missing {f['label']} (required)")
                continue
            parsed[f["name"]] = v
            if not _value_ok(f, v):
                issues.append(_bad_value_msg(f, v))
        elif kind == "skip" and CONVENTION[fi]["required"]:
            issues.append(f"Missing {CONVENTION[fi]['label']} (required)")
        elif kind == "extra":
            issues.append(f"Unexpected segment '{segments[sj]}'")

    # Initiative code must exist in the register.
    parts = [parsed.get(k) for k in ("program_brand", "program", "outcome", "initiative_id")]
    if known_initiatives is not None and all(parts):
        code = DELIMITER.join(parts)
        if code not in {k.lower() for k in known_initiatives}:
            issues.append(f"Initiative code '{code.upper()}' isn't in the initiative register")

    # Platform code vs where the campaign actually runs.
    plat = parsed.get("platform")
    if source_platform and plat:
        expected = SOURCE_PLATFORM_CODES.get(str(source_platform).strip().lower())
        if expected and plat not in expected:
            issues.append(f"Platform code '{plat}' but campaign runs on {source_platform} "
                          f"(expected {'/'.join(sorted(expected))})")

    # Channel makes sense for platform.
    chan = parsed.get("channel")
    if plat and chan and plat in PLATFORM_CHANNELS and chan not in PLATFORM_CHANNELS[plat]:
        issues.append(f"Channel '{chan}' doesn't fit platform '{plat}'")

    return {"is_compliant": not issues, "issues": issues, "parsed": parsed}


def validate_dataframe(df, name_col="campaign_name", platform_col=None,
                       known_initiatives=KNOWN_INITIATIVES):
    """For Count / pandas: returns a copy of df with the check results added."""
    out = df.copy()
    names = out[name_col].tolist()
    plats = out[platform_col].tolist() if platform_col else [None] * len(out)
    results = [validate_name(n, p, known_initiatives) for n, p in zip(names, plats)]
    out["is_compliant"] = [r["is_compliant"] for r in results]
    out["issue_count"] = [len(r["issues"]) for r in results]
    out["issues"] = ["; ".join(r["issues"]) for r in results]
    for f in CONVENTION:
        out[f"field_{f['name']}"] = [r["parsed"].get(f["name"]) for r in results]
    return out



