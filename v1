def _align(segments, conv=None):
    """
    Match segments to fields allowing optional fields to be left out.
    Edit-distance style: picks the reading of the name with the fewest problems,
    so a missing field is reported as missing rather than shifting every later
    field into the wrong slot.
    """
    conv = conv or CONVENTION
    n, m = len(conv), len(segments)
    INF = float("inf")
    cost = [[INF] * (m + 1) for _ in range(n + 1)]
    back = [[None] * (m + 1) for _ in range(n + 1)]
    cost[0][0] = 0
    for i in range(n + 1):
        for j in range(m + 1):
            c = cost[i][j]
            if c == INF:
                continue
            if i < n and j < m:                          # field i uses segment j
                f, v = conv[i], segments[j]
                step = 0 if (v == "" and not f["required"]) or (v and _value_ok(f, v)) else 1
                if c + step < cost[i + 1][j + 1]:
                    cost[i + 1][j + 1], back[i + 1][j + 1] = c + step, ("use", i, j)
            if i < n:                                    # field i left out
                step = 1 if conv[i]["required"] else 0
                if c + step < cost[i + 1][j]:
                    cost[i + 1][j], back[i + 1][j] = c + step, ("skip", i, None)
            if j < m:                                    # segment j doesn't belong
                if c + 1 < cost[i][j + 1]:
                    cost[i][j + 1], back[i][j + 1] = c + 1, ("extra", None, j)

    steps, i, j = [], n, m
    while (i, j) != (0, 0):
        kind, fi, sj = back[i][j]
        steps.append((kind, fi, sj))
        if kind == "use":
            i, j = i - 1, j - 1
        elif kind == "skip":
            i -= 1
        else:
            j -= 1
    return list(reversed(steps))


