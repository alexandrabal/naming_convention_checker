def _blank(v):
    return v is None or (isinstance(v, float) and v != v) or str(v).strip() == ""


def _tracker_code(field, text):
    """Tracker dropdown text -> code used in names. '' if blank, None if unreadable."""
    if _blank(text):
        return ""
    t = str(text).strip()
    low = t.lower()
    allowed = FIELDS[field].get("_allowed_set", set())
    m = re.search(r"\(([^()]*)\)\s*$", t)                 # "Brand awareness (BAW)"
    if m and m.group(1).strip().lower() in allowed:
        return m.group(1).strip().lower()
    slug = re.sub(r"\s+", "-", low)                       # "Paid social" -> paid-social
    if slug in allowed:
        return slug
    aliases = TRACKER_ALIASES.get(field, {})
    if low in aliases:
        return aliases[low]
    first = re.split(r"[\s(/]", low)[0]                   # "Mixed (META vid+sta)" -> mixed
    if first in aliases:
        return aliases[first]
    if field == "country" and low.startswith("all"):     # "All Countries/Multiple countries"
        return "all"
    return None


ALL_FIELDS = [f["name"] for f in CONVENTION] + ["activity_name", "program_brand", "outcome"]


def _all_bad(reason):
    return {f: reason for f in ALL_FIELDS}


def _missing_warning(f):
    return f"WARNING: {f['label'].lower()} missing from name (required)"


def _initiative_warning(v):
    """Say which part of the initiative id is wrong."""
    types = ", ".join(INITIATIVE_TYPES)
    parts = v.split("-")
    if parts[0] != "27":
        return f"WARNING: initiative id '{v}' should start with 27- (e.g. 27-tst-t01-src)"
    if len(parts) < 2 or parts[1] not in INITIATIVE_TYPES:
        t = parts[1] if len(parts) > 1 else ""
        return f"WARNING: initiative type '{t}' not in initiative type list ({types})"
    rest = parts[2:]
    if rest and re.fullmatch(r"[ta]\d{2}", rest[0]):
        rest = rest[1:]
    elif rest and re.fullmatch(r"[a-z]?\d+", rest[0]):
        return f"WARNING: initiative number '{rest[0]}' should be t## or a## (e.g. t01, a05)"
    product = "-".join(rest)
    if product and product not in PRODUCTS:
        return f"WARNING: product '{product}' not in product list"
    return f"WARNING: initiative id '{v}' isn't in the format 27-type-id-product"


def _field_warning(f, v):
    """Warning for a value that isn't in the field's list."""
    if f["name"] == "initiative_id":
        return _initiative_warning(v)
    label = f["label"].lower()
    if f["name"] == "country":
        return f"WARNING: '{v}' not in country list (use a 2-letter code, or all)"
    if "allowed" not in f:                         # free-text fields, e.g. FY26 activity name
        return f"WARNING: {label} '{v}' should start with a letter or number and only use lowercase letters, numbers and -"
    opts = [str(o).lower() for o in f["allowed"]]
    if len(opts) <= 20:
        return f"WARNING: '{v}' not in {label} list ({', '.join(opts)})"
    return f"WARNING: '{v}' not in {label} list"


def validate_name(name, source_platform=None, known_initiatives=KNOWN_INITIATIVES):
    """
    Returns dict: is_compliant, issues (list), parsed ({field: value}),
    bad_fields ({field: "WARNING: reason"} for fields with a problem).
    """
    if name is None or (isinstance(name, float) and name != name):  # None / NaN
        name = ""
    raw = str(name)
    name = raw.strip()
    issues, parsed, bad = [], {}, {}

    if not name:
        return {"is_compliant": False, "issues": ["Campaign name is empty"],
                "parsed": {}, "bad_fields": _all_bad("WARNING: name is empty")}

    if raw != name:
        issues.append("Spaces at start/end")
    if name != name.lower():
        issues.append("Not lowercase")
    if " " in name:
        issues.append("Has spaces")
    if len(name) > MAX_LENGTH:
        issues.append(f"Too long ({len(name)}/{MAX_LENGTH})")
    bad_chars = sorted(set(re.sub(r"[a-z0-9_\-]", "", name.lower().replace(" ", ""))))
    if bad_chars:
        issues.append(f"Bad characters: {' '.join(bad_chars)}")

    lname = name.lower()

    # The program code (e.g. avst_itm_cex_27) is taken as ONE segment, not split.
    m = PROGRAM_END.search(lname)
    year = m.group(1) if m else "27"
    conv = CONVENTIONS[year]
    fields = {f["name"]: f for f in conv}
    parsed["fy"] = "fy" + year
    if m and year == "27":
        program = lname[:m.end()]                  # avst_itm_cex_27
        rest = lname[m.end() - 2:]                 # 27-evp-a05_mp1_...  (27 shared)
        segments = [program] + rest.split(DELIMITER)
    elif m:
        program = lname[:m.end()]                  # avst_brd_bdm_26
        rest = lname[m.end() + 1:]                 # hcai-report-_paid-social_li_...
        segments = [program] + (rest.split(DELIMITER) if rest else [])
    else:
        # No program code at all: still read the rest so each field gets its own warning.
        bad["program"] = "WARNING: no program code found (should start like sr_pr_caq_27 or sr_pr_caq_26)"
        # A name with no _ at all (free text) has no fields to read.
        segments = [""] + lname.split(DELIMITER) if DELIMITER in lname else [""]

    field_issues = []
    for kind, fi, sj in _align(segments, conv):
        if kind == "use":
            f, v = conv[fi], segments[sj]
            if v == "":
                if f["required"]:
                    field_issues.append(f"No {f['label'].lower()}")
                    bad.setdefault(f["name"], _missing_warning(f))
                continue
            parsed[f["name"]] = v
            if not _value_ok(f, v):
                field_issues.append(_bad_value_msg(f, v))
                bad.setdefault(f["name"], _field_warning(f, v))
        elif kind == "skip" and conv[fi]["required"]:
            field_issues.append(f"No {conv[fi]['label'].lower()}")
            bad.setdefault(conv[fi]["name"], _missing_warning(conv[fi]))
        elif kind == "extra":
            field_issues.append(f"Extra '{segments[sj]}'")

    # Many problems: summarise in the issues text, but every field still keeps
    # its own warning in its _check column.
    if not m or len(field_issues) >= STRUCTURE_LIMIT:
        issues.append(STRUCTURE_MSGS[year])
        extras = [x for x in field_issues if x.startswith("Extra")]
        if extras:
            issues.append("; ".join(extras))
    else:
        issues += field_issues

    # Brand and outcome read from a valid program code (for reporting only).
    prog = parsed.get("program")
    prog_ok = bool(prog) and _value_ok(fields["program"], prog)
    if prog_ok:
        bits = prog.split(DELIMITER)
        parsed["program_brand"], parsed["outcome"] = bits[0], bits[-2]

    # Initiative code (program + initiative id) must exist in the register.
    init = parsed.get("initiative_id")
    if (known_initiatives is not None and "initiative_id" in fields and prog_ok and init
            and _value_ok(fields["initiative_id"], init)):
        suffix = init[2:]                          # -evp-a05
        code = prog + suffix                       # avst_itm_cex_27-evp-a05
        register = {_init_key(k) for k in known_initiatives}
        if code not in register and suffix not in register:
            issues.append(f"Initiative '{code}' not in register")
            bad.setdefault("initiative_id", f"WARNING: '{code}' not in initiative register")

    # Only cross-check platform/channel when the codes themselves are valid
    # (otherwise the same mistake gets reported twice).
    plat = parsed.get("platform")
    plat = plat if plat and _value_ok(fields["platform"], plat) else None
    chan = parsed.get("channel")
    chan = chan if chan and _value_ok(fields["channel"], chan) else None

    # Platform code vs where the campaign actually runs.
    if source_platform and plat:
        expected = SOURCE_PLATFORM_CODES.get(str(source_platform).strip().lower())
        if expected and plat not in expected:
            issues.append(f"Platform '{plat}' but runs on {source_platform}")
            bad.setdefault("platform", f"WARNING: '{plat}' but campaign runs on {source_platform}")

    # Channel makes sense for platform.
    if plat and chan and plat in PLATFORM_CHANNELS and chan not in PLATFORM_CHANNELS[plat]:
        issues.append(f"Channel '{chan}' doesn't fit platform '{plat}'")
        bad.setdefault("channel", f"WARNING: '{chan}' doesn't fit platform '{plat}'")

    return {"is_compliant": not issues, "issues": issues, "parsed": parsed, "bad_fields": bad}


def validate_dataframe(df, name_col="campaign_name", platform_col=None,
                       known_initiatives=KNOWN_INITIATIVES, tracker_cols=None):
    """
    For Count / pandas: returns a copy of df with the check results added.
    tracker_cols = {field: actual column name} for the tracker columns present.
    """
    tracker_cols = tracker_cols or {}
    out = df.copy()
    plats = out[platform_col].tolist() if platform_col else [None] * len(out)
    rows = out.to_dict("records")

    all_issues, bad_all, parsed_all = [], [], []
    for row, p in zip(rows, plats):
        r = validate_name(row[name_col], p, known_initiatives)
        issues, bad, parsed = list(r["issues"]), dict(r["bad_fields"]), r["parsed"]
        year = parsed.get("fy", "fy27")[2:]
        in_conv = {f["name"] for f in CONVENTIONS[year]} | {"program_brand", "outcome"}

        # Compare each tracker column with what the name says.
        # (Platform is already compared through platform_col above.)
        for field, col in tracker_cols.items():
            if field == "platform" or field in bad or field not in in_conv:
                continue
            label = TRACKER_COLS[field].rstrip("*").strip()
            val = row[col]
            if field == "initiative_id":
                tv = "" if _blank(val) else _init_key(val)
                prog, init = parsed.get("program"), parsed.get("initiative_id")
                nv = prog + init[2:] if prog and init else ""
            else:
                tv, nv = _tracker_code(field, val), parsed.get(field, "")
            if tv is None:
                issues.append(f"{label}: can't read tracker value '{val}'")
                bad.setdefault(field, f"WARNING: can't read tracker value '{val}'")
            elif tv != nv:
                issues.append(f"{label}: tracker '{tv or 'blank'}' but name '{nv or 'blank'}'")
                bad.setdefault(field, f"WARNING: tracker says '{tv or 'blank'}', name has '{nv or 'blank'}'")

        if "program" in bad:                       # these all depend on the program code
            for dep in ("program_brand", "outcome"):
                bad.setdefault(dep, "WARNING: can't read, program code is wrong")
        for field in ALL_FIELDS:                   # e.g. goal doesn't exist in FY26 names
            if field not in in_conv:
                bad[field] = f"N/A (not in FY{year} names)"
        all_issues.append(issues)
        bad_all.append(bad)
        parsed_all.append(parsed)

    out["is_compliant"] = [not i for i in all_issues]
    out["issue_count"] = [len(i) for i in all_issues]
    out["issues"] = ["; ".join(i) for i in all_issues]
    out[NAME_CHECK_COL] = ["WARNING" if i else "OK" for i in all_issues]
    # Each field_<x> column is followed by field_<x>_check: "OK" or "WARNING: <reason>".
    out["field_fy"] = [pr.get("fy") for pr in parsed_all]
    for col in ["program", "program_brand", "outcome", "activity_name"] + [f["name"] for f in CONVENTION[1:]]:
        out[f"field_{col}"] = [pr.get(col) for pr in parsed_all]
        out[f"field_{col}_check"] = [b.get(col, "OK") for b in bad_all]

    # campaign_status: OK only if the name check and every field check are OK
    # (N/A counts as OK). Anything else -> WARNING.
    check_cols = [NAME_CHECK_COL] + [c for c in out.columns if c.startswith("field_") and c.endswith("_check")]
    out["campaign_status"] = [
        "OK" if all(v == "OK" or str(v).startswith("N/A") for v in row) else "WARNING"
        for row in out[check_cols].itertuples(index=False)
    ]
    return out



